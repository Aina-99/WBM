<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Contrôle Modèle - Résultats"
        Height="700" Width="1100"
        MinHeight="450" MinWidth="750"
        WindowStartupLocation="CenterScreen"
        Background="#F4F6F9"
        FontFamily="Segoe UI">

    <Window.Resources>

        <SolidColorBrush x:Key="AccentBrush" Color="#2563EB"/>
        <SolidColorBrush x:Key="ErrorBrush" Color="#DC2626"/>
        <SolidColorBrush x:Key="WarningBrush" Color="#D97706"/>
        <SolidColorBrush x:Key="InfoBrush" Color="#0891B2"/>
        <SolidColorBrush x:Key="TextMutedBrush" Color="#64748B"/>
        <SolidColorBrush x:Key="BorderBrush2" Color="#E2E8F0"/>

        <Style x:Key="PillButton" TargetType="Button">
            <Setter Property="Background" Value="{StaticResource AccentBrush}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="14,6"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Opacity" Value="0.88"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="SecondaryButton" TargetType="Button" BasedOn="{StaticResource PillButton}">
            <Setter Property="Background" Value="White"/>
            <Setter Property="Foreground" Value="#1E293B"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush2}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ShowButton" TargetType="Button" BasedOn="{StaticResource PillButton}">
            <Setter Property="Padding" Value="10,4"/>
            <Setter Property="FontSize" Value="11"/>
        </Style>

        <Style x:Key="CountCard" TargetType="Border">
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="16,10"/>
            <Setter Property="Margin" Value="0,0,10,0"/>
        </Style>

        <Style TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="#F8FAFC"/>
            <Setter Property="Foreground" Value="{StaticResource TextMutedBrush}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="10,10"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush2}"/>
            <Setter Property="BorderThickness" Value="0,0,0,1"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
        </Style>

        <Style TargetType="DataGridRow">
            <Setter Property="Background" Value="White"/>
            <Style.Triggers>
                <Trigger Property="AlternationIndex" Value="1">
                    <Setter Property="Background" Value="#FAFBFC"/>
                </Trigger>
            </Style.Triggers>
        </Style>

    </Window.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- En-tete -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,16">
            <TextBlock Text="Contrôle Modèle" FontSize="22" FontWeight="Bold" Foreground="#0F172A"/>
            <TextBlock x:Name="lbl_model_name" Text="" FontSize="13" Foreground="{StaticResource TextMutedBrush}"
                       VerticalAlignment="Bottom" Margin="12,0,0,3"/>
        </StackPanel>

        <!-- Cartes de synthese (masquees pour l'instant, non prioritaire) -->
        <StackPanel x:Name="panel_dashboard" Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,16" Visibility="Collapsed">
            <Border Style="{StaticResource CountCard}" Background="#FEF2F2">
                <StackPanel Orientation="Horizontal">
                    <TextBlock x:Name="lbl_error_count" Text="0" FontSize="20" FontWeight="Bold" Foreground="{StaticResource ErrorBrush}"/>
                    <TextBlock Text="Erreurs" FontSize="12" Foreground="{StaticResource ErrorBrush}" Margin="8,4,0,0"/>
                </StackPanel>
            </Border>
            <Border Style="{StaticResource CountCard}" Background="#FFFBEB">
                <StackPanel Orientation="Horizontal">
                    <TextBlock x:Name="lbl_warning_count" Text="0" FontSize="20" FontWeight="Bold" Foreground="{StaticResource WarningBrush}"/>
                    <TextBlock Text="Avertissements" FontSize="12" Foreground="{StaticResource WarningBrush}" Margin="8,4,0,0"/>
                </StackPanel>
            </Border>
            <Border Style="{StaticResource CountCard}" Background="#ECFEFF">
                <StackPanel Orientation="Horizontal">
                    <TextBlock x:Name="lbl_info_count" Text="0" FontSize="20" FontWeight="Bold" Foreground="{StaticResource InfoBrush}"/>
                    <TextBlock Text="Informations" FontSize="12" Foreground="{StaticResource InfoBrush}" Margin="8,4,0,0"/>
                </StackPanel>
            </Border>
            <Border Style="{StaticResource CountCard}" Background="#F1F5F9" Margin="0">
                <StackPanel Orientation="Horizontal">
                    <TextBlock x:Name="lbl_total_count" Text="0" FontSize="20" FontWeight="Bold" Foreground="#1E293B"/>
                    <TextBlock Text="Total" FontSize="12" Foreground="#1E293B" Margin="8,4,0,0"/>
                </StackPanel>
            </Border>
        </StackPanel>

        <!-- Barre de filtres -->
        <Grid Grid.Row="2" Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <TextBox x:Name="txt_search" Grid.Column="0" Height="32" Padding="8,6" VerticalContentAlignment="Center"
                     BorderBrush="{StaticResource BorderBrush2}" BorderThickness="1" Background="White"
                     TextChanged="on_filter_changed" Margin="0,0,10,0"/>

            <StackPanel Grid.Column="1" Orientation="Horizontal">
                <!-- Filtre sevérité masque pour l'instant, non prioritaire -->
                <ComboBox x:Name="cmb_severity" Width="180" Height="32" VerticalContentAlignment="Center"
                          SelectionChanged="on_filter_changed" Margin="0,0,10,0" Visibility="Collapsed"/>

                <ComboBox x:Name="cmb_category" Width="220" Height="32" VerticalContentAlignment="Center"
                          SelectionChanged="on_filter_changed" Margin="0,0,10,0"/>

                <Button x:Name="btn_rerun" Content="Relancer le contrôle" Style="{StaticResource SecondaryButton}"
                        Click="on_rerun_click"/>
            </StackPanel>
        </Grid>

        <!-- Resultats -->
        <Border Grid.Row="3" Background="White" CornerRadius="8" BorderBrush="{StaticResource BorderBrush2}" BorderThickness="1">
            <DataGrid x:Name="grid_results"
                      AutoGenerateColumns="False"
                      CanUserAddRows="False"
                      CanUserDeleteRows="False"
                      CanUserReorderColumns="False"
                      IsReadOnly="True"
                      GridLinesVisibility="Horizontal"
                      HorizontalGridLinesBrush="#EEF1F5"
                      HeadersVisibility="Column"
                      RowHeight="42"
                      AlternationCount="2"
                      BorderThickness="0"
                      Background="Transparent"
                      SelectionMode="Single"
                      SelectionUnit="FullRow">
                <DataGrid.Columns>

                    <!-- Colonne severite masquee pour l'instant, non prioritaire -->
                    <DataGridTemplateColumn Header="Sévérité" Width="130" Visibility="Collapsed">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Border Background="{Binding SeverityBrush}" CornerRadius="10" Padding="10,3" HorizontalAlignment="Left">
                                    <TextBlock Text="{Binding Severity}" Foreground="White" FontSize="11" FontWeight="SemiBold"/>
                                </Border>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <DataGridTextColumn Header="Catégorie" Binding="{Binding Category}" Width="130"/>
                    <DataGridTextColumn Header="Règle" Binding="{Binding Rule}" Width="220"/>
                    <DataGridTextColumn Header="Description" Binding="{Binding Description}" Width="*"/>
                    <DataGridTextColumn Header="Id" Binding="{Binding ElementIdText}" Width="80"/>

                    <DataGridTemplateColumn Header="Action" Width="110">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Button Content="Afficher" Style="{StaticResource ShowButton}"
                                        Click="on_show_click" Tag="{Binding}"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                </DataGrid.Columns>
            </DataGrid>
        </Border>

        <!-- Pied de fenetre -->
        <Grid Grid.Row="4" Margin="0,16,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <TextBlock x:Name="lbl_status" Grid.Column="0" VerticalAlignment="Center"
                       Foreground="{StaticResource TextMutedBrush}" FontSize="12"/>

            <Button Grid.Column="1" Content="Exporter (CSV)" Style="{StaticResource SecondaryButton}"
                    Click="on_export_click" Margin="0,0,10,0"/>
            <Button Grid.Column="2" Content="Fermer" Style="{StaticResource PillButton}"
                    Click="on_close_click"/>
        </Grid>

    </Grid>
</Window>
