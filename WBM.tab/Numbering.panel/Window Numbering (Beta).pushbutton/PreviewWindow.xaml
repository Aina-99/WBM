<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Window Numbering (Beta) - Prévisualisation"
        Height="600" Width="700"
        MinHeight="400" MinWidth="520"
        WindowStartupLocation="CenterScreen"
        Background="#F4F6F9"
        FontFamily="Segoe UI">

    <Window.Resources>

        <SolidColorBrush x:Key="AccentBrush" Color="#2563EB"/>
        <SolidColorBrush x:Key="TextMutedBrush" Color="#64748B"/>
        <SolidColorBrush x:Key="BorderBrush2" Color="#E2E8F0"/>

        <Style x:Key="PillButton" TargetType="Button">
            <Setter Property="Background" Value="{StaticResource AccentBrush}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="14,6"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Opacity" Value="0.88"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="SecondaryButton" TargetType="Button" BasedOn="{StaticResource PillButton}">
            <Setter Property="Background" Value="White"/>
            <Setter Property="Foreground" Value="#1E293B"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush2}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="RowActionButton" TargetType="Button" BasedOn="{StaticResource SecondaryButton}">
            <Setter Property="Padding" Value="0"/>
            <Setter Property="FontSize" Value="10"/>
        </Style>

        <Style TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="#F8FAFC"/>
            <Setter Property="Foreground" Value="{StaticResource TextMutedBrush}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="10,10"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush2}"/>
            <Setter Property="BorderThickness" Value="0,0,0,1"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
        </Style>

        <Style TargetType="DataGridRow">
            <Setter Property="Background" Value="White"/>
            <Style.Triggers>
                <Trigger Property="AlternationIndex" Value="1">
                    <Setter Property="Background" Value="#FAFBFC"/>
                </Trigger>
            </Style.Triggers>
        </Style>

    </Window.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- En-tete -->
        <StackPanel Grid.Row="0" Margin="0,0,0,12">
            <TextBlock Text="Window Numbering (Beta)" FontSize="22" FontWeight="Bold" Foreground="#0F172A"/>
            <TextBlock Text="Vérifiez l'ordre proposé avant d'appliquer. Glissez-déposez une ligne pour la réordonner, ou cliquez 🔍 pour localiser la fenêtre dans Revit."
                       FontSize="12" Foreground="{StaticResource TextMutedBrush}" Margin="0,4,0,0"/>

            <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                <TextBlock Text="Prefixe" VerticalAlignment="Center"
                           Foreground="{StaticResource TextMutedBrush}" FontSize="12" Margin="0,0,8,0"/>
                <TextBox x:Name="txt_prefix" Width="60" Height="28" VerticalContentAlignment="Center"
                         Padding="6,0" BorderBrush="{StaticResource BorderBrush2}" Margin="0,0,20,0"/>

                <TextBlock Text="Repère d'entrée" VerticalAlignment="Center"
                           Foreground="{StaticResource TextMutedBrush}" FontSize="12" Margin="0,0,8,0"/>
                <TextBlock x:Name="lbl_entry_marker" Text="(aucun repère sélectionné)" Width="220"
                           VerticalAlignment="Center" FontStyle="Italic" Foreground="#94A3B8" FontSize="12" Margin="0,0,8,0"/>
                <Button Content="Choisir dans la vue" Style="{StaticResource SecondaryButton}"
                        Click="on_pick_entry_click" Margin="0,0,20,0"/>

                <Button Content="Calculer" Style="{StaticResource SecondaryButton}"
                        Click="on_calculate_click"/>
            </StackPanel>
        </StackPanel>

        <!-- Tableau -->
        <Border Grid.Row="1" Background="White" CornerRadius="8" BorderBrush="{StaticResource BorderBrush2}" BorderThickness="1">
            <DataGrid x:Name="grid_preview"
                      AutoGenerateColumns="False"
                      CanUserAddRows="False"
                      CanUserDeleteRows="False"
                      CanUserReorderColumns="False"
                      IsReadOnly="True"
                      GridLinesVisibility="Horizontal"
                      HorizontalGridLinesBrush="#EEF1F5"
                      HeadersVisibility="Column"
                      RowHeight="32"
                      AlternationCount="2"
                      BorderThickness="0"
                      Background="Transparent"
                      SelectionMode="Single"
                      SelectionUnit="FullRow"
                      SelectionChanged="on_row_selected"
                      AllowDrop="True"
                      PreviewMouseLeftButtonDown="on_grid_preview_mouse_down"
                      MouseMove="on_grid_mouse_move"
                      DragOver="on_grid_drag_over"
                      Drop="on_grid_drop">
                <DataGrid.Columns>
                    <DataGridTemplateColumn Header="" Width="40" CanUserResize="False">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Button Content="🔍" Width="24" Height="22" Style="{StaticResource RowActionButton}"
                                        Tag="{Binding}" Click="on_show_click"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTextColumn Header="#" Binding="{Binding Rank}" Width="50"/>
                    <DataGridTextColumn Header="Mark" Binding="{Binding Mark}" Width="*"/>
                    <DataGridTextColumn Header="Id" Binding="{Binding Id}" Width="90"/>
                </DataGrid.Columns>
            </DataGrid>
        </Border>

        <!-- Pied de fenetre -->
        <Grid Grid.Row="2" Margin="0,16,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <TextBlock x:Name="lbl_status" Grid.Column="0" VerticalAlignment="Center"
                       Foreground="{StaticResource TextMutedBrush}" FontSize="12"/>

            <Button Grid.Column="1" Content="Appliquer" Style="{StaticResource PillButton}"
                    Click="on_apply_click" Margin="0,0,10,0"/>
            <Button Grid.Column="2" Content="Fermer" Style="{StaticResource SecondaryButton}"
                    Click="on_close_click"/>
        </Grid>

    </Grid>
</Window>
